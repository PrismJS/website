{
	"$schema": "https://typedoc.org/schema.json",
	"out": "./_site/api",
	"json": "./_site/api/docs.json",
	"name": "Prism API",
	"includeVersion": true,
	"entryPoints": [".prism/src/**/*.js", ".prism/src/types.d.ts"],
	"exclude": [".prism/src/plugins/**/*.js", ".prism/src/languages/**/*.js"],
	"externalPattern": ["**/node_modules/**/node_modules/**"],
	"compilerOptions": {
		"skipLibCheck": true,
		"noCheck": true,
		"allowJs": true
	},
	"markdownItOptions": {
		"html": true,
		"linkify": true,
		"typographer": true
	},
	"plugin": ["typedoc-plugin-rename-defaults"],
	"navigationLinks": {
		"Home": "https://prismjs.com",
		"GitHub": "https://github.com/PrismJS/prism"
	},
	"favicon": "./assets/logo.svg",
	"hostedBaseUrl": "https://prismjs.com/api",
	"readme": "none"
}
