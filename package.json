{
	"name": "prismjs-website",
	"version": "0.0.1",
	"description": "Prism website",
	"type": "module",
	"scripts": {
		"postinstall": "node _build/postinstall.mjs",
		"dev": "netlify dev -p 8844",
		"serve": "docspire --serve",
		"build:html": "docspire",
		"build:apidocs": "npx typedoc",
		"build": "npm run build:html && npm run build:apidocs",
		"watch:html": "docspire --watch",
		"watch": "npm run watch:html"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PrismJS/website.git"
	},
	"bugs": {
		"url": "https://github.com/PrismJS/website/issues"
	},
	"homepage": "https://prismjs.com",
	"license": "MIT",
	"devDependencies": {
		"docspire": "^0",
		"markdown-it-deflist": "^4",
		"prettier": "^3.9.9",
		"prettier-plugin-brace-style": "latest",
		"prettier-plugin-merge": "latest",
		"prettier-plugin-space-before-function-paren": "latest",
		"typedoc": "^0.28.20",
		"typedoc-plugin-rename-defaults": "^0.7.3"
	}
}
